{
    "name": "murmure",
    "private": true,
    "scripts": {
        "dev": "turbo dev",
        "dev:admin": "turbo dev --filter=admin",
        "dev:desktop": "turbo dev --filter=desktop",
        "build": "turbo build",
        "db:generate": "turbo db:generate",
        "db:push": "turbo db:push",
        "lint": "turbo lint",
        "format": "prettier --write \"**/*.{ts,tsx,md}\""
    },
    "devDependencies": {
        "turbo": "^2.0.0",
        "prettier": "^3.8.1"
    },
    "packageManager": "pnpm@9.0.0"
}
